# No secrets are needed by local loading, indexing, or retrieval.
# Contextual query rewriting uses an OpenAI-compatible Chat Completions endpoint.
# Copy this file to .env and fill values locally. Never commit .env.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Optional provider compatibility setting. DeepSeek defaults to disabled here.
LLM_THINKING_MODE=disabled

# Current paths are configured with command-line flags. Possible future names:
# POLICY_REPOSITORY=data/site-policy
# POLICY_INDEX_PATH=cache/policy_index.json
