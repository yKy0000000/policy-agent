{
  "version": "query-structure-router-v1",
  "status": "frozen",
  "input": "rewritten_query; for the frozen single-turn evaluation sets = the original query",
  "normalization": {
    "strip": true,
    "collapse_whitespace": true,
    "regex_flags": "IGNORECASE"
  },
  "signals": {
    "question_marks_ge_2": {
      "definition": "count('?') >= 2"
    },
    "interrogative_words_ge_2": {
      "pattern": "\\b(what|where|when|which|who|whom|whose|how|why)\\b",
      "broad_if": "count >= 2"
    },
    "list_markers": {
      "pattern": "(^|\\n)\\s*([-*\\u2022]|\\d+[.)])\\s",
      "additional": "';' present",
      "broad_if": "true"
    },
    "multi_clause_conjunction": {
      "definition": "count(',') >= 2 and re.search(r'\\b(and|or)\\b', q, IGNORECASE)",
      "broad_if": "true"
    },
    "words_gt_35": {
      "definition": "len(q.split()) > 35",
      "broad_if": "true"
    }
  },
  "rule": "SIMPLE iff no signal fires; otherwise BROAD (conservative default to BROAD)",
  "no_llm": true,
  "prohibited": "Must not be edited after the first Stage 1 call. Any change requires a new version and full revalidation; Stage 1 may not tune this rule on observed results.",
  "distribution": {
    "validation_v1_50": {
      "BROAD": 29,
      "SIMPLE": 21,
